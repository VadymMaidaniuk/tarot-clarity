# Server-side only. Never exposed to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=90000
# Reasoning tokens count toward this budget on thinking models.
OPENROUTER_MAX_TOKENS=4000
# Reasoning effort: low (default), medium, high, or none to switch reasoning
# off. Models that require reasoning (e.g. Gemini 3.x) reject "none".
OPENROUTER_REASONING=low

# Sent to OpenRouter as HTTP-Referer for usage attribution.
APP_URL=http://localhost:3000
