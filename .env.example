# auto = local outside Vercel, openrouter on Vercel
LLM_PROVIDER=auto

# Ollama default. LM Studio commonly uses http://127.0.0.1:1234/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=90000
LOCAL_LLM_MAX_TOKENS=1200

# Required when LLM_PROVIDER=openrouter or when deployed with auto.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_TOKENS=1600
APP_URL=http://localhost:3000

# Development controls.
ALLOW_PROVIDER_OVERRIDE=true
LLM_FALLBACK_TO_DEMO=true
